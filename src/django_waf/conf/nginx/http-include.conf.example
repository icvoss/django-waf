# django-waf reference nginx wiring, http{} scope include (#31)
#
# django-waf is an export utility, not an auto-enforcing package: it writes
# the file below (map/geo variable declarations) and can reload nginx, but
# it never edits your nginx configuration itself. You wire the include and
# the enforcement snippet (server-include.conf.example, alongside this
# file) by hand, once, and django-waf keeps the generated variables fresh
# on the schedule configured for the generate_blocklist task (every 5
# minutes by default, BR-BL-004).
#
# WHERE THIS GOES
# ----------------
# `map` and `geo` directives are only valid at the http{} configuration
# level, never inside a server{} or location{} block. Drop this file (or
# its contents) into your http{}-scope include directory, typically
# /etc/nginx/conf.d/ on most distributions. Do not paste this into a
# server{} block, nginx will refuse to start.
#
#   /etc/nginx/nginx.conf
#   http {
#       ...
#       include /etc/nginx/conf.d/*.conf;   # <- this already includes conf.d
#       ...
#   }
#
# THE WRITABLE-PATH PATTERN
# --------------------------
# The Django process that runs the generate_blocklist Celery task is
# typically an unprivileged application user, not root, and /etc/nginx/
# is root-owned on most distributions. Two supported options:
#
#   1. Grant the application user write access to a specific file under
#      /etc/nginx/conf.d/ (e.g. via a setgid directory or an ACL) so
#      DJANGO_WAF_NGINX_BLOCKLIST_PATH can point directly at
#      /etc/nginx/conf.d/django-waf-blocklist.conf.
#
#   2. Point DJANGO_WAF_NGINX_BLOCKLIST_PATH at a path the application
#      user already owns (e.g. /var/lib/django-waf/blocklist.conf) and
#      `include` that absolute path from within your http{} block, or
#      from a conf.d file you own:
#
#          # /etc/nginx/conf.d/django-waf-blocklist.conf (owned by root,
#          # edited once, never touched by django-waf again)
#          include /var/lib/django-waf/blocklist.conf;
#
#      This indirection means the generated file itself never needs to
#      live under /etc/nginx/ at all, only this one static include line
#      does, and it never changes.
#
# WHAT THE GENERATED FILE DECLARES
# ----------------------------------
# generate_nginx_blocklist() (django_waf/services/blocklist_generator.py)
# writes four variables from active BlockRules (BR-BL-001, BR-BL-005):
#
#   $waf_block_ip      geo , 1 for an IP/CIDR rule with action=block
#   $waf_block_ua       map, 1 for a UA rule with action=block
#   $waf_throttle_ip    geo, 1 for an IP/CIDR rule with action=throttle
#   $waf_throttle_ua    map, 1 for a UA rule with action=throttle
#
# Declaring these variables does nothing on its own, nginx does not act
# on a $waf_block_ip value of 1 unless a server{} or location{} block
# checks it. See server-include.conf.example for the enforcement half.

include /etc/nginx/conf.d/django-waf-blocklist.conf;
